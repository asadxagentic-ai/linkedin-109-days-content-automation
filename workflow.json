        "jsCode": "const item = $input.first();\nconst raw = item.json?.output || item.json?.text || item.json?.message?.content || item.json?.response || '';\n\n// Strip markdown that won't render on LinkedIn\nconst cleaned = raw\n  .replace(/\\*\\*(.+?)\\*\\*/g, '$1')  // **bold** → plain\n  .replace(/\\*(.+?)\\*/g, '$1')      // *italic* → plain\n  .replace(/^---+$/gm, '')           // remove horizontal rules\n  .replace(/\\n{3,}/g, '\\n\\n')       // collapse 3+ newlines to double\n  .trim();\n\nreturn [{\n  json: {\n    ...item.json,\n    linkedinPost: cleaned\n  }\n}];\n"
      },
